# Ubuntu 로봇 PC 배포용 설정. `cp .env.example .env` 후 값을 채운다. (.env 는 git 에 올라가지 않는다)

# 외부에 여는 포트. PIPER Studio 를 개발 모드(dev.sh)로 띄워 8000 을 쓰고 있으면 바꾼다.
SSORRY_PORT=8000

# 카메라 이름. 첫 번째가 기본 카메라 (판정 bbox 의 기본 기준).
CAMERAS=top,wrist

# piper: PIPER Studio 가 카메라를 쥐고 있을 때 / ingest: LeRobot 이 카메라를 쥐고 프레임을 밀어 넣을 때
CAMERA_SOURCE=piper
PIPER_URL=http://host.docker.internal
# 로봇 미션 프로그램(Piper `mission.py --serve`) 주소. /control/* 가 여기로 넘긴다. 토큰은 INGEST_TOKEN 을 같이 쓴다.
ROBOT_CONTROL_URL=http://host.docker.internal:8765
# 이름=PIPER카메라 라벨. PIPER 카메라 페이지에서 두 카메라에 라벨(top, wrist)을 붙이고 여기 적는다.
# /dev/videoN 같은 id 도 되지만 재부팅하면 바뀔 수 있다.
# 등록된 카메라 확인: curl -s http://localhost/api/cameras/current | python3 -m json.tool
# 여기 없는 카메라는 ingest 로 받을 수 있다.
PIPER_CAMERAS=top=top,wrist=wrist

# /ingest/* 토큰. `openssl rand -hex 16` 으로 만든다. LeRobot 쪽 SsorryClient(token=...) 에 같은 값을 준다.
INGEST_TOKEN=CHANGE_ME

# 개발용. 운영에서는 비워 둔다.
UVICORN_RELOAD=
MOCK=0
